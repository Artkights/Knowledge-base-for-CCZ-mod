{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "entityType",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entityType": {
      "const": "data-structure"
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "evidence",
          "sourceRefs"
        ]
      }
    }
  },
  "additionalProperties": false,
  "title": "CCZ data-structure collection"
}
