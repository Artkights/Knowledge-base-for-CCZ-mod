{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCZ workflow collection",
  "type": "object",
  "required": ["schemaVersion", "entityType", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entityType": {"const": "workflow"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "evidence", "sourceRefs", "goal", "inputs", "steps", "gates", "outputs", "rollback"]
      }
    }
  },
  "additionalProperties": false
}
