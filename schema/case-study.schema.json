{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCZ case-study collection",
  "type": "object",
  "required": ["schemaVersion", "entityType", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entityType": {"const": "case-study"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "evidence", "sourceRefs", "objective", "inputs", "procedure", "outcome", "reusableLessons"]
      }
    }
  },
  "additionalProperties": false
}
