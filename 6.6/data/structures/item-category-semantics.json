        "src.items.semantic-resolver",
        "src.items.legacy-equipment",
        "src.items.legacy-consumable",
        "src.items.semantic-tests",
        "src.items.user-confirmation",
        "src.items.byte-evidence",
        "src.integration.record-codecs-current"
      ],
