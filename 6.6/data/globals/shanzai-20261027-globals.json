        "src.ccz.shanzai.kb.qi"
      ]
    },
    {
      "id": "global.66.qi.gate-switch",
      "title": "6.6 集气分流开关（4018 与前置门）",
      "aliases": [
        "0x00505EC8",
        "0x00505FDC",
        "4018",
        "集气开关"
      ],
      "versions": [
        "6.6"
      ],
      "profile": "profile.ccz66.shanzai.work.1b25",
      "status": "canonical",
      "evidence": "sample-verified",
      "address": {
        "kind": "va",
        "value": "0x00505EC8",
        "profile": "profile.ccz66.shanzai.work.1b25",
        "evidence": "sample-verified"
      },
      "width": 4,
      "type": "int32-flag",
      "meaning": "整型变量 4018 = 0x505EC8，集气判定第二道门（须 == 1）；相邻 0x505FDC 是第一道门（须 == 0 才继续）。集气在装的真条件 = [0x505FDC]==0 且 [0x505EC8]==1，任一不满足即回原版随机路径。该变量同址二义：它同时是我方回合「我方必中」开关，改它会同时开/关两件事。",
      "lifecycle": "运行期由用户在游戏内设置/脚本写入；静态样本里三处开关均为初值 0（本次现读 0x505FDC / 0x505EC8 / 0x505EC4 全 00）。",
      "relations": [
        "fn.66.qi.gate-check"
      ],
      "sourceRefs": [
        "src.ccz.shanzai.work.1b25.exe",
        "src.ccz.shanzai.kb.qi"
      ]
    },
    {
      "id": "global.66.surround.target-list",
      "title": "6.6 周边目标 slot 列表与引导目标数",
      "aliases": [
        "0x00500EA5",
        "0x00500E9C",
        "周边目标列表",
        "引导链目标数"
      ],
      "versions": [
