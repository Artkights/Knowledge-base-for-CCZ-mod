      ],
      "profile": "profile.ccz66.shanzai.work.1b25",
      "status": "candidate",
      "evidence": "sample-verified",
      "address": {
        "kind": "va",
        "value": "0x00500EA5",
        "profile": "profile.ccz66.shanzai.work.1b25",
        "evidence": "sample-verified"
      },
      "width": 1,
      "type": "byte-array-ff-terminated",
      "meaning": "0x500EA5 起为「周边目标 slot 列表」，0xFF 终止、无计数变量（奋战 0x4363F1 / 引导 0x4212F1 共用）；0x500E9C 是引导链目标数（独立 byte），不是周边人数；相邻 0x500E9A 是阶段/列表标志的 1 字节槽（写入侧有 byte/word 混用，word 只覆盖 0x500E9A~0x500E9B），0x500E9D 是 byte 目标数组（FF 终止）。四者相邻但不构成 dword 结构。",
      "lifecycle": "运行期按招式生成/复用；静态样本里本次现读 0x500EA5 = `FF` 后接 0（空列表哨兵）。",
      "sourceRefs": [
        "src.ccz.shanzai.work.1b25.exe",
        "src.ccz.shanzai.kb.surround"
      ]
    },
