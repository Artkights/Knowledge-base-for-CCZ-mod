    {
      "id": "fn.66.learn-mask-query.8ba1",
      "title": "学会策略类别掩码查询（0x43E1A8）",
      "aliases": [
        "0x0043E1A8",
        "learn-mask-query",
        "0x004E",
        "0x006C"
      ],
      "versions": [
        "6.6"
      ],
      "profile": "profile.ccz66.xinnai12.local.8ba1",
      "status": "candidate",
      "evidence": "static-verified",
      "address": {
        "kind": "va",
        "value": "0x0043E1A8",
        "profile": "profile.ccz66.xinnai12.local.8ba1",
        "evidence": "static-verified"
      },
      "callingConvention": "栈参 k（0..2），ECX=人物记录",
      "inputs": "arg1=k；查询 0x42518F(0x4E+k, 0x6C, 3, 0)",
      "returns": "EAX=学会策略特效值（作为 8 位类别掩码）",
      "semantics": "k=0 查兵种特效 0x4E（学会策略 气候）+装备 0x6C（学会策略）；k=1 查 0x4F（兵法 heyho!）；k=2 查 0x50（学会策略 四神）+0x6C。模式 3 = 按位或，把三路来源的类别位合并。返回的掩码在 0x41DC78/0x465AC1/0x41FF6E 与 0x4D17B0[strategyId] 按位与。",
      "relations": [
        "fn.66.strategy-select-loop.8ba1",
        "mechanism.66.learn-strategy-category-mask.8ba1"
      ],
      "sourceRefs": [
        "src.ccz66.xinnai12.ekd5.8ba1"
      ]
    },
    {
      "id": "fn.66.strategy-select-loop.8ba1",
      "title": "策略选择循环（0x465AC1 / 0x41DC78）",
      "aliases": [
        "0x00465AC1",
        "0x0041DC78",
        "strategy-select-loop"
      ],
      "versions": [
        "6.6"
      ],
      "profile": "profile.ccz66.xinnai12.local.8ba1",
      "status": "candidate",
      "evidence": "static-verified",
      "address": {
        "kind": "va",
        "value": "0x00465AC1",
        "profile": "profile.ccz66.xinnai12.local.8ba1",
        "evidence": "static-verified"
      },
      "callingConvention": "0x465AC1：ECX=人物，栈参（输出位图, 偏移, 模式），ret 0x10；0x41DC78：ECX=人物，栈参（严格模式），ret 4",
      "inputs": "遍历策略 ID 0..0x8F；k=0..2",
      "returns": "0x465AC1 无返回，把可选策略写成 outBuf[id+偏移]=1；0x41DC78 返回计数",
      "semantics": "对每个 k 调 0x43E1A8 得到类别掩码，再与 0x4D17B0[strategyId] AND；k=0 且不匹配时回退 0x41832B（射程/目标）与 0x40DE69（可用性）。0x465AC1 在模式>1 时用 0x484002/0x425AD0 的 MP 与 [人物+0x14] 比较；模式≠0 时才要求 0x4D14E0 bit0。0x41DC78 的严格模式只影响是否过滤 bit0=1。",
      "relations": [
        "fn.66.learn-mask-query.8ba1",
        "fn.66.learn-category-and.8ba1",
        "fn.66.strategy-select-count.8ba1",
        "mechanism.66.learn-strategy-category-mask.8ba1",
        "mechanism.66.strategy-selectable-gates.8ba1"
      ],
      "sourceRefs": [
        "src.ccz66.xinnai12.ekd5.8ba1"
      ]
    },
    {
      "id": "fn.66.learn-category-and.8ba1",
      "title": "类别掩码按位与判定（0x465AFB / 0x41DCAD）",
      "aliases": [
        "0x00465AFB",
        "0x0041DCAD",
        "learn-category-and"
      ],
      "versions": [
        "6.6"
      ],
      "profile": "profile.ccz66.xinnai12.local.8ba1",
      "status": "candidate",
      "evidence": "static-verified",
      "address": {
        "kind": "va",
        "value": "0x00465AFB",
        "profile": "profile.ccz66.xinnai12.local.8ba1",
        "evidence": "static-verified"
      },
      "callingConvention": "循环体内联",
      "inputs": "ECX=学会策略掩码；EAX=策略 ID",
      "returns": "标志；非 0 表示该策略属于已学会类别",
      "semantics": "mov al,[eax+0x4D17B0]; and ecx,eax; test ecx,ecx。0x41DCAD 是模仿/计数路径的同一判定。掩码为 0 时直接跳过 AND，进入 k==0 的回退检查。",
      "relations": [
        "fn.66.strategy-select-loop.8ba1"
      ],
      "sourceRefs": [
        "src.ccz66.xinnai12.ekd5.8ba1"
      ]
    },
    {
      "id": "fn.66.strategy-extra-gates.8ba1",
