      "address": {
        "kind": "va",
        "value": "0x0042518F",
        "profile": "profile.ccz66.xinnai12.local.8ba1",
        "evidence": "static-verified"
      },
      "callingConvention": "thiscall；ECX=人物记录；栈参（兵种特效ID, 装备特效ID, 合并模式, 装备取值模式）；ret 0x10",
      "inputs": "arg1=兵种特效 ID，arg2=装备特效 ID，arg3=合并模式（0 加/1 取大/2 七优先/3 OR），arg4=装备取值模式（0 取值/非0 取存在=100）",
      "returns": "EAX=特效查询值；EDX=人物 ID",
      "semantics": "0x40B922 判定战斗场景（0x40B913()==3）：非 0 转 0x4101D9，否则转 0x41301E；两者都按两个特效 ID 查询并按 arg3 合并。",
