{
  "schemaVersion": 1,
  "analysis": "strategy-damage-direction-weather-terrain-modifier",
  "date": "2026-11-12",
  "method": "精确反汇编策略伤害 0x43C022 的 0x43C15E..0x43C1E8 段，并反汇编 0x44270C（方向/攻击码 getter）与 0x41553B（当前天气 getter）；核对三基底字节。仅读本地基底，不运行游戏、不修改游戏文件。",
  "samples": [
    {"version": "6.4", "label": "洗隋", "engine": "基底/洗隋/Ekd5.exe", "engineSha256": "91121D4B5F7FBB987475943A590B76308C0DDB8B6BCD17C218EEDC6568CE2AD8"},
    {"version": "6.5", "label": "加强版6.5未加密版", "engine": "基底/加强版6.5未加密版/Ekd5.exe", "engineSha256": "3EF71541803689338D40AFD86D1D34F1E74E1A02EDA29A204A40F3F95EC547ED"},
    {"version": "6.6", "label": "复刻版6.6山贼", "engine": "基底/复刻版6.6山贼/Ekd5.exe", "engineSha256": "25D488C874A08553903CDAD9A07FF6FBCD1A38EE6C6B6386F40152DA963D833A"}
  ],
  "getters": {
    "directionOrAttackCode": {
      "va": "0x44270C",
      "code": "return byte[unit + 0xF]",
      "bytes": "55 8B EC 0F B6 41 0F 5D C3",
      "identity": "6.4/6.5/6.6 字节一致",
      "status": "字段名未最终确认；按战术单位结构 +0xF 为朝向/方向候选"
    },
    "currentWeather": {
      "va": "0x41553B",
      "code": "category=byte[0x4B3D19]; weather=byte[0x4B3D0C]; return byte[category*6 + weather + 0x48E100]",
      "bytes": "0F B6 41 11 6B D0 06 8A 41 04 8A 84 10 00 E1 48 00 5D C3",
      "identity": "6.4/6.5/6.6 字节一致",
      "returns": "天气 ID 0..4"
    }
  },
  "modifierChain": {
    "va": "0x43C15E..0x43C1E8",
    "steps": [
      "series = 0x40BF0C([ebp+0xC])",
      "if series <= 0x27: damage = damage * row6[series] / 100（0x43C16D）",
      "code = 0x44270C([ebp-0x20])",
      "code == 0：若 series == 0x1E，[ebp-0xC] += 0x28；terrain = 0x435991([ebp+8]+6)；terrain == 2 或 0x17 → [ebp-0xC] += 0x19",
      "code == 1 / 3 / 0x26：weather = 0x41553B(0x4B3D08)；weather >= 2 → [ebp-0xC] += 0x19",
      "code == 2：若 0x43B4A7([ebp-0x10]) == 7 → [ebp-0xC] += 0x19",
      "统一加值分支 0x43C1DE：[ebp-0xC] += 0x19",
      "damage = damage * [ebp-0xC] / 100（0x425AD9，0x43C1E8）"
    ],
    "constants": [
      {"value": "0x28", "meaning": "serie==0x1E 时的百分比加值 40"},
      {"value": "0x19", "meaning": "方向/天气/地形条件满足时的百分比加值 25"},
      {"value": "2 / 0x17", "meaning": "触发 +25 的地形码"},
      {"value": "2", "meaning": "天气 ID 阈值（>=2 触发）"},
      {"value": "0x1E / 7", "meaning": "触发加值的兵种系 ID"},
      {"value": "0 / 1 / 3 / 0x26 / 2", "meaning": "0x44270C 返回的方向/攻击码分支"}
    ]
  },
  "versionDifferences": {
    "0x44270C": "6.4/6.5/6.6 字节一致",
    "0x41553B": "6.4/6.5/6.6 字节一致",
    "modifierBlock": {"6.4": "00F017B1", "6.5/6.6": "C1767879", "note": "0x43C19F 起的 80 字节块 6.4 与 6.5/6.6 不同"}
  },
  "conclusion": "策略伤害在兵种系第 6 行百分比之后，还会按方向/攻击码追加百分比：方向码 0 时检查兵种系 0x1E（+40）与地形码 2/0x17（+25）；方向码 1/3/0x26 时检查当前天气 ID>=2（+25）；方向码 2 时检查另一侧兵种系==7（+25）；最终按 damage*累计百分比/100 乘算。方向 getter 与天气 getter 三基底一致，但修正块 6.4 不同。",
  "limitations": [
    "0x44270C 的 +0xF 字段最终名称未确定（朝向/攻击方向候选）。",
    "地形码 2/0x17 未映射到 30 类地形名称。",
    "天气 ID 0..4 的玩法名称未命名。",
    "0x1E/7 兵种系的名称未命名。",
    "未运行游戏对照。"
  ]
}
