  "actionReset": {
    "va": "0x41626A",
    "loop": "byte index 0..0xF9 (250)",
    "filter": "0x4061F9(index) 取战场对象；0x418C90 = byte[obj+0xC]，要求 ==2",
    "operations": [
      "0x406690(obj, 6)：byte[obj+0xD] &= ~6",
      "0x423FB9(obj, 0x1E)：按参数位构造掩码，清除 byte[obj+0x1E] 的对应位",
      "0x45F670(obj) → 0x4061E4 → 0x407263 取值，再 0x43F6DB(obj, value)：dword[obj+0x10] = min(value, 原值)",
      "循环结束后 0x453AC3(0x4B4250)、0x44A88A(0x4B3D08)，返回 1"
    ],
    "verifiedConstants": {
      "0xFA": "战场对象循环上限 250（三基底同值）",
      "2": "0x418C90 过滤值（byte[obj+0xC]）",
      "6": "清除 byte[obj+0xD] 的位掩码",
      "0x1E": "清除 byte[obj+0x1E] 的位掩码实参"
    },
    "fieldStatus": "obj+0xC/+0xD/+0x10/+0x1E 的玩法名称未最终命名；本条只记录读写方式与常量。"
