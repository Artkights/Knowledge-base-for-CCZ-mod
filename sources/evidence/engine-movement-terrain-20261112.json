  "tableLayout": {
    "sourceBlock": {"index": 4, "fileOffset": "0xA8A4", "length": "0x960", "rows": 40, "rowSize": 60},
    "runtimeTable": {"base": "0x4A3517", "rowStride": "0x3C", "rows": 40, "accessor": "0x41B7D4 = family*0x3C + 0x4A3517"},
    "halves": {
      "terrainAdaptation": {"offset": 0, "width": 30, "reader": "0x41F62A = byte[row + terrain]"},
      "movementCost": {"offset": "0x1E", "width": 30, "reader": "0x4060C4 = byte[row + 0x1E + terrain]"}
    },
    "loader": "0x41B790 循环 40 次，0x40956F 将每行前 30 字节写 row+0，后 30 字节写 row+0x1E"
  },
  "accessors": {
    "moveCostGetter": {
      "va": "0x4065AD",
      "code": "jobId=[ebp+8]; terrain=[ebp+0xC]; row=0x41B7D4(jobId); return 0x4060C4(row, terrain)",
      "meaning": "按兵种 ID 与地形 ID 取移动消耗"
    },
    "adaptationIfPassable": {
      "va": "0x46CC12",
      "code": "cost=0x4060C4(row,terrain); if cost!=0xFF return 0x41F62A(row,terrain); else return 0",
      "meaning": "不可通行（0xFF）时返回 0，否则返回地形适应值"
    },
    "passabilityCheck": {
      "va": "0x459380",
      "code": "series=0x43B4A7(unit); terrain=0x435991(coord); row=0x41B7D4(series); cost=0x4060C4(row,terrain); cost==0xFF 时再用 0x403A6F(unit) 判定，返回 1 或 0xFF",
      "meaning": "移动/通行判定"
    },
    "aiTerrain": {
      "va": "0x43F809",
      "code": "row=0x41B7D4(job); adaptation=0x41F62A(row,terrain); 后续 0x412B5F/0x43F96F 分支",
      "meaning": "AI 读取地形适应"
    }
  },
  "mapBounds": {
    "function": "0x435991",
    "code": "if byte[coord+0] >= byte[0x4B422C] → 0xFF; if byte[coord+1] >= byte[0x4B422D] → 0xFF; else 0x412557(coord)",
    "globals": {"0x4B422C": "地图宽度（字节，待命名确认）", "0x4B422D": "地图高度（字节，待命名确认）"},
    "outOfBoundsSentinel": "0xFF"
  },
