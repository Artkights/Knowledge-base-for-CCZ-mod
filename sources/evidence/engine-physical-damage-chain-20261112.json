      {"va": "0x43BD84", "versions": "6.4/6.5", "code": "diff<0 时 damage += damage * (abs(diff)*5) / 100", "constant": 5, "note": "0x43BD86 imul eax,eax,5；0x425AD9 乘算"},
      {"va": "0x43BD7E", "versions": "6.6", "code": "diff 取负后 +0xC，再乘 edx，damage = damage * (该值) / 100", "constant": 12, "note": "0x43BD80 add eax,0xC；与 6.4/6.5 的固定 5 不同"},
      {"va": "0x43BD9B", "code": "兵种相克 0x426737，counter!=100 时 damage = max(1, damage*counter/100)"},
      {"va": "0x43BDBF", "code": "0x4E6000(攻方, 守方, damage) 最终处理"}
    ]
