    {
      "id": "mechanism.65.pierce-attack-replacement.3890",
      "title": "穿透攻击-xx：以特效参数替换穿透范围",
      "aliases": [
        "穿透攻击",
        "pierce attack replacement"
      ],
      "versions": [
        "6.5"
      ],
      "profile": "profile.ccz65.unencrypted.3890.scan",
      "status": "candidate",
      "evidence": "static-verified",
      "steps": [
        {
          "order": 1,
          "entity": "fn.65.pierce-loader",
          "role": "0x40782D 穿透加载入口"
        },
        {
          "order": 2,
          "entity": "fn.65.pierce-effect-chain.3890",
          "role": "0x40CC13 顺序查 0x77..0x7F"
        },
        {
          "order": 3,
          "entity": "fn.65.param-getter-gated.3890",
          "role": "0x42518F 逐个取特效参数"
        },
        {
          "order": 4,
          "entity": "fn.65.pierce-expand-wrapper",
          "role": "0x4364C7 接收穿透码并展开"
        },
        {
          "order": 5,
          "entity": "fn.65.strategy-range-dispatch.3890",
          "role": "0x435CE9 12 分支几何展开"
        },
        {
          "order": 6,
