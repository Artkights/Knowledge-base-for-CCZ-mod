      "evidence": "static-verified",
      "steps": [
        {
          "order": 1,
          "entity": "fn.65.pierce-loader",
          "role": "0x40782D 按单位类型查 0x407881 表/必杀分支"
        },
        {
          "order": 2,
          "entity": "fn.65.pierce-expand-wrapper",
          "role": "0x4364C7 取单位/角色后转 0x435CE9"
        },
        {
          "order": 3,
          "entity": "fn.65.strategy-range-dispatch.3890",
          "role": "0x435CE9 12 分支展开"
        },
        {
          "order": 4,
          "entity": "fn.65.pierce-geometry-dispatch",
          "role": "0x436616 四向/四角几何展开"
        },
        {
          "order": 5,
          "entity": "fn.65.pierce-append-target",
          "role": "0x437AFF 落格与去重"
        }
      ],
      "state": [
        "global.65.range-target-buffer",
        "global.65.range-target-write-index"
      ],
      "semantics": [
        "0x407881 为单位类型 0..0x4F 的穿透模式表（0/1/4/9/0x0A）。",
        "穿透码与策略范围共用 0x435CE9 的 12 项跳转表 0x435EF8。",
        "落格缓冲 0x4AC748 起、0x4B2C34 为游标、0xFF 终止；0x4B2C28 为比较值。"
      ],
      "relations": [
        "mechanism.65.attack-range-grid-write.3890"
      ],
