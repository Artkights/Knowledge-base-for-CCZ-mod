    {
      "id": "mechanism.65.attack-range-tier-expansion.3890",
      "title": "攻击/必杀范围等级拓展链（四向→九宫→没羽）",
      "aliases": [
        "拓展范围",
        "range tier expansion",
        "0x41CEAB 范围跳转"
      ],
      "versions": [
        "6.5"
      ],
      "profile": "profile.ccz65.unencrypted.3890.scan",
      "status": "candidate",
      "evidence": "static-verified",
      "steps": [
        {
          "order": 1,
          "entity": "fn.65.fatal-range-selector.3890",
          "role": "0x43F8C0 取必杀范围/特殊判定"
        },
        {
          "order": 2,
          "entity": "fn.65.attack-range-wrapper.3890",
          "role": "0x417A35 包装并传 default=1"
        },
        {
          "order": 3,
          "entity": "fn.65.attack-range-tier-check.3890",
          "role": "0x41CDEE 按 特效号=r+0x5A 判定"
        },
        {
          "order": 4,
          "entity": "fn.65.attack-range-tier-map.3890",
          "role": "0x41CE8B 查 0x41CEAB 返回下一级"
        },
        {
          "order": 5,
          "entity": "fn.65.attack-dispatch",
          "role": "0x436511 按范围码查 0x4D1400 展开"
        },
        {
          "order": 6,
          "entity": "fn.65.attack-append-target",
          "role": "0x437AFF 边界/阵营/去重落格"
        }
      ],
      "state": [
        "global.65.attack-range-tier-table.3890",
        "global.65.range-pointer-table"
      ],
      "semantics": [
        "范围等级 r：0=四向、1=九宫、6=没羽、0x0C=大没羽；拥有拓展特效后按 0x41CEAB 链式跳一级（0x00→0x01→0x06→0x0C→0x0D→0x21）。",
        "0x41CDEE 的特效号是动态 r+0x5A（默认 0x76），所以常量为 0x5A..0x7B 的动态读取，不是固定桩。",
        "同一张 0x41CEAB 表也被 0x401DFF 用于策略动画模板 t=record+0xC 的升级。"
      ],
      "relations": [
        "mechanism.65.attack-range-grid-write.3890"
      ],
      "sourceRefs": [
