          "role": "0x437AFF：边界检查后落格"
        },
        {
          "order": 2,
          "entity": "fn.65.cell-slot-reader.3890",
          "role": "0x435884：读 P 层返回格内单位槽号"
        }
      ],
      "state": [
        "global.65.grid-status-map.3890",
        "global.65.range-target-buffer",
        "global.65.range-target-write-index"
      ],
      "contextOffsets": [
        {
          "base": "0x004AAFF4",
          "offset": "0x0",
          "meaning": "B 层：落格结果/占位"
        },
        {
          "base": "0x004AAFF4",
          "offset": "0xC80",
          "meaning": "M 层：mFlag 时写 1"
        },
        {
          "base": "0x004AEB38",
          "offset": "0xC80",
          "meaning": "P 层：0x435884 读取的槽号来源"
        },
        {
          "base": "0x004AEB38",
          "offset": "0x12C0",
          "meaning": "A 层：落格结果同值写入"
        }
      ],
      "semantics": [
        "0x437AFF 只做坐标换算与 A/B/M 层写入，不读取任何地形表。",
        "0x418CD0 把 (x,y) 打包为 word；0x403789 计算 y*width+x（width 取 0x4B422C）。",
        "flags&0x80 为 0 时 A/B 写同值；mFlag 非 0 时 M=1。",
        "0x435884 返回 0..0xF9 的槽号，>=0xFA 归一为 0xFF；不要解释为单位指针低字节。"
      ],
      "relations": [
        "fn.65.attack-append-target",
        "global.65.range-pointer-table"
      ],
