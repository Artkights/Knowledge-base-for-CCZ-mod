      "inputs": {
        "ebp+8": "槽中兵种ID",
        "ebp+0C": "单位详细兵种ID"
      },
      "returns": "AL=0匹配，AL=1不匹配",
      "semantics": "槽ID>=80拒绝；精确标志开启时比ID，否则按族并要求分配ID<=当前ID；FF自然拒绝。",
