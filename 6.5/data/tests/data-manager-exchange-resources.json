      "id": "test.data-manager.business-xlsx-contract",
      "title": "业务 XLSX 基线、权限白名单、控制文本与组合草稿测试",
      "versions": [
        "6.4",
        "6.5",
        "6.6"
      ],
      "status": "canonical",
      "evidence": "source-reviewed",
      "sourceRefs": [
        "src.data-manager.incremental-20261102.xlsx-package",
        "src.data-manager.incremental-20261102.xlsx-service",
        "src.data-manager.incremental-20261102.xlsx-registry",
        "src.data-manager.incremental-20261102.xlsx-models",
        "src.data-manager.incremental-20261102.xlsx-doc",
        "src.data-manager.incremental-20261102.xlsx-tests",
        "src.data-manager.incremental-20261102.xlsx-native-tests",
        "src.data-manager.incremental-20261102.xlsx-text-tests",
        "src.data-manager.incremental-20261102.exchange-test-runner",
        "src.dm.current-validation-20261102",
        "src.dm.current-source-inventory-20261102"
      ],
      "command": "dotnet run --project data管理器/src/DataManager.Tests/DataManager.Tests.csproj --configuration Release --no-build -- --page-workbook <sample-root>",
      "target": "PageWorkbookTests + WorkbookNativeTests（内部包含WorkbookTextEncodingTests）",
      "mutationScope": "只在CreateCoreCopy生成的临时项目和临时XLSX中编辑/生成/清理；原始样本只读取。",
      "assertions": [
        "可用业务页导出后OpenXmlValidator有效且原样回导零修改；显示表重命名/重排与缺数据行不视为删除",
        "预检不产生草稿；应用一条修改后整体撤回/重做，重复导入零修改",
        "三方冲突与确认后草稿变化、重复/新增ID、公式、超范围、超长文本、缺表和未知字段均整本拒绝且无部分草稿泄漏",
        "宝物装备许可白名单/兵种策略只读名称生效；辅助原生分组与物理表一并导入/撤回/重做",
        "控制字符、CR/LF、多行和_xNNNN_字面转义保真，拓展数据工作簿零变更往返"
      ],
      "requiredArtifacts": [
        "完整console日志与退出码0",
        "PAGE_WORKBOOK_TESTS_OK",
        "WORKBOOK_NATIVE_TESTS_OK auxiliary+physical/extend/undo/redo",
        "每页WORKBOOK_ROUNDTRIP_OK及样本身份"
      ],
      "failureMeaning": "任何失败表示交换协议、权限/冲突或组合草稿原子性不满足；不得把可打开Excel视为安全导入。",
      "executionBoundary": "本实体记录当前源码定义的可复现测试契约；本轮实际执行结果由独立运行日志登记，未执行不得写为已通过。",
      "prerequisites": [
        "使用同一Release配置构建；这是自定义console runner，不是dotnet test",
        "<sample-root>必须为可加载且具备测试所需人物/装备及原生辅助分组的样本目录；不能省略并依赖当前工作目录猜测"
      ],
      "lastExecution": {
