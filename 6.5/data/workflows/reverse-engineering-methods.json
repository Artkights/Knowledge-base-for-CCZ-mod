  "entries": [
    {
      "id": "workflow.65pl.reverse-engineering-migration",
      "title": "6.5pl 反汇编结论迁移与 Hook 设计",
      "versions": [
        "6.5pl"
      ],
      "status": "candidate",
      "evidence": "source-reviewed",
      "profile": null,
      "goal": "把上游参考样本中的核心入口、调度器、桩参数和对象身份结论迁移到新样本，同时保留证据边界和可回滚条件。",
      "inputs": [
        "目标 EXE 和 SHA256",
        "PE32/x86 画像草案",
        "上游候选扫描输出",
        "行为契约与正负样本",
        "原字节快照"
      ],
      "steps": [
        {
          "order": 1,
          "action": "固定目标文件 SHA256、大小、时间戳和模块基址，建立独立 profile 草案。"
        },
        {
          "order": 2,
          "action": "只读解析 MZ/PE 头与节表，建立 VA、RVA、文件偏移和节权限映射。"
        },
        {
          "order": 3,
          "action": "以 E8 交叉引用、常量、步长和调用形状定位候选入口，保存原始字节和函数边界。"
        },
        {
          "order": 4,
          "action": "按基本块追踪操作数最后定义、前驱路径、ECX/EDX/栈参数和 EFLAGS，构建 CFG。"
        },
        {
          "order": 5,
          "action": "区分 TacticalUnit、CharacterData、DataRecord、事务区和调用帧局部值，验证编号宽度与步长。"
        },
        {
          "order": 6,
          "action": "核对 ret N/add esp、返回值消费者、预检分支和所有提前返回，再决定候选语义。"
        },
        {
          "order": 7,
          "action": "为 Hook 或补丁登记 expectedBytes、完整指令边界、桩入口、回跳、重定位和冲突所有权。"
        },
        {
          "order": 8,
          "action": "在测试副本做静态复读、文件读回、运行时读回和正负场景验证，更新 evidence/status。"
        }
      ],
      "gates": [
        "地址必须绑定当前 SHA profile。",
        "任何跨分支拼接、线性扫描命中或函数名猜测都不能升级结论。",
        "缺少原字节、ABI、回跳或动态证据时保持 candidate 且禁止自动写入。",
        "代码洞、覆盖长度和寄存器/栈守恒必须逐项审计。"
      ],
      "outputs": [
        "profile 草案",
        "CFG/调用链和操作数来源记录",
        "对象身份与字段映射",
        "候选补丁契约",
        "静态/文件/运行时验证报告"
      ],
      "rollback": [
        "删除测试副本补丁并恢复原字节",
        "保留失败现场、日志和未决研究项",
        "撤销未通过门禁的自动生成配置"
      ],
      "sourceRefs": [
        "src.upstream.lanceyuki.de63.74b842bd2170",
        "src.upstream.lanceyuki.de63.014d84819d26",
        "src.upstream.lanceyuki.de63.6a7cae8887b5",
        "src.upstream.lanceyuki.de63.33953c21ed13",
        "src.upstream.lanceyuki.de63.fc8bae5c6374",
        "src.upstream.lanceyuki.de63.98faa1bb9ee1",
        "src.upstream.lanceyuki.de63.3385870b029f",
        "src.upstream.lanceyuki.de63.ec1407637ce2",
        "src.upstream.lanceyuki.de63.221bb4bdbcc0"
      ]
    },
    {
      "id": "workflow.65pl.x32dbg-runtime-evidence",
      "title": "6.5pl x32dbg 运行时证据采集",
      "versions": [
        "6.5pl",
        "6.5",
        "6.6"
      ],
      "status": "candidate",
      "evidence": "source-reviewed",
      "profile": null,
      "goal": "用最小、可恢复的运行时实验验证静态反汇编对分支、指针、值和消费者的解释。",
      "inputs": [
        "精确样本及模块基址",
        "可复现存档或场景",
        "要证明的单一事件",
        "断点计划",
        "静态候选地址或 RVA"
      ],
      "steps": [
        {
          "order": 1,
          "action": "确认 x86/x64 架构、进程、模块和复现步骤，先把旧绝对地址换算为当前模块 RVA。"
        },
        {
          "order": 2,
          "action": "写明本次只证明的事件、命中条件、预期读写字段和未覆盖路径。"
        },
        {
          "order": 3,
          "action": "按目标选择软件、硬件、内存、条件、跟踪或日志断点，设置最小命中范围。"
        },
        {
          "order": 4,
          "action": "暂停后记录线程、当前指令/RVA、寄存器、EFLAGS、调用栈和关键内存。"
        },
        {
          "order": 5,
          "action": "沿后续指令跟踪写入者、读取者、比较和最终消费者，区分命中计数与条件成立。"
        },
        {
          "order": 6,
          "action": "若必须写入，只做测试副本中的最小变更，保存原字节并立即读回。"
        },
        {
          "order": 7,
          "action": "恢复临时写入，重复正样本、负样本和边界样本，避免把一次命中当作完整功能。"
        },
        {
          "order": 8,
          "action": "将架构、断点类型、条件、线程、停点、寄存器、内存、外部结果和未覆盖路径写入证据记录。"
        }
      ],
      "gates": [
        "运行时地址必须由当前模块基址和 profile 推导。",
        "条件断点命中次数不能代替路径成立证据。",
        "临时写入必须可恢复，且不得直接生成持久补丁。"
      ],
      "outputs": [
        "运行时快照",
        "读写者/消费者链",
        "正负样本对照",
        "恢复确认",
        "证据升级或研究缺口"
      ],
      "rollback": [
        "恢复测试副本和内存现场",
        "清除断点、跟踪和临时文件",
        "若现场污染则停止推广并保留原样本"
      ],
      "sourceRefs": [
        "src.upstream.lanceyuki.de63.74b842bd2170",
        "src.upstream.lanceyuki.de63.014d84819d26",
        "src.upstream.lanceyuki.de63.6a7cae8887b5",
        "src.forum.godtype.194034",
        "src.history.local.godtype-f36-synthesis"
      ]
    },
    {
      "id": "workflow.65pl.engine-feature-development",
      "title": "引擎特效功能的行为契约到分层验收",
      "versions": [
        "6.5pl",
        "6.5",
        "6.6"
      ],
      "status": "candidate",
      "evidence": "source-reviewed",
      "profile": null,
      "goal": "从行为契约出发追到真实读取、选择、修饰、写回和消费者路径，生成可回滚的最小修改并逐层验收。",
      "inputs": [
        "目标版本画像",
        "命中/未命中/边界场景",
        "静态调用链",
        "ABI 和寄存器契约",
        "补丁前后字节"
      ],
      "steps": [
        {
          "order": 1,
          "action": "锁定样本并保护基线，记录目标行为契约和验收场景。"
        },
        {
          "order": 2,
          "action": "按目标引擎追踪真实读取、选择、修饰、写回和消费者，核实调用约定、栈、寄存器和 flags。"
        },
        {
          "order": 3,
          "action": "设计最小可回滚改动，登记原字节、完整指令、索引终止规则、代码洞和冲突。"
        },
        {
          "order": 4,
          "action": "用单一生成源计算跳转/替换字节并断言长度、边界、模块范围和原字节匹配。"
        },
        {
          "order": 5,
          "action": "先做静态反汇编复读，再做文件读回和差异审计。"
        },
        {
          "order": 6,
          "action": "在测试副本做运行时读回和受控路径观察，记录写入者与结果消费者。"
        },
        {
          "order": 7,
          "action": "执行游戏内正负样本和副作用检查，分离功能结果与未覆盖路径。"
        },
        {
          "order": 8,
          "action": "沉淀实体、证据、边界和回滚信息；证据不足时退回 candidate。"
        }
      ],
      "gates": [
        "参考地址不能直接复制到新版本。",
        "连续零/NOP 不能自动判定为空闲代码洞。",
        "断点命中不能代替结果验收。",
        "命中、未命中、提前返回和原生门控都必须保持栈/寄存器/flags 守恒。"
      ],
      "outputs": [
        "行为契约",
        "补丁配方和回滚字节",
        "分层验证报告",
        "可查询结构化实体",
        "研究缺口清单"
      ],
      "rollback": [
        "逆序恢复写入站点和页保护",
        "恢复测试副本/存档",
        "删除未通过证据门禁的自动配置"
      ],
      "sourceRefs": [
        "src.upstream.lanceyuki.de63.74b842bd2170",
        "src.upstream.lanceyuki.de63.014d84819d26",
        "src.upstream.lanceyuki.de63.6a7cae8887b5",
        "src.upstream.lanceyuki.de63.33953c21ed13",
        "src.forum.godtype.194034",
        "src.history.local.godtype-f36-synthesis"
      ]
    }
  ]
}
