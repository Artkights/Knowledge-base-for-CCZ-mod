  "entries": [
    {
      "id": "format.e5.indexed-archive",
      "title": "E5 索引资源封包",
      "aliases": [
        "E5 格式",
        "E5 archive"
      ],
      "versions": [
        "6.5",
        "6.6"
      ],
      "status": "canonical",
      "evidence": "source-reviewed",
      "magic": null,
      "endianness": "big for directory fields",
      "header": {
        "directoryOffset": "0x110"
      },
      "directory": {
        "entrySize": 12,
        "entryNumberBase": 1,
        "trailerLengths": [
          0,
          4
        ],
        "fourByteTrailerValue": "00000000"
      },
      "entryFields": [
        {
          "name": "stored_length",
          "offset": "0x0",
          "width": 4,
          "type": "uint32be",
          "meaning": "封包中实际字节数"
        },
        {
          "name": "decoded_length",
          "offset": "0x4",
          "width": 4,
          "type": "uint32be",
          "meaning": "解码后字节数"
        },
        {
          "name": "payload_offset",
          "offset": "0x8",
          "width": 4,
          "type": "uint32be",
          "meaning": "相对文件开头的负载偏移"
        }
      ],
      "semantics": [
        "stored_length != decoded_length 表示 LS12 压缩",
        "首项 payload_offset 决定目录项数量",
        "完全相同的负载范围允许共享；其它相交范围为异常",
        "未压缩负载可按 BMP/JPG/PNG/RAW 魔数或尺寸识别"
      ],
      "sourceRefs": [
        "src.ccz.e5-parser"
      ]
    },
    {
      "id": "format.eex.probed-header",
      "title": "EEX 文件识别魔数",
      "versions": [
        "6.5",
        "6.6"
      ],
      "status": "canonical",
      "evidence": "source-reviewed",
      "magic": {
        "offset": "0x00",
        "bytes": "45 45 58 00",
        "text": "EEX\\0"
      },
      "endianness": "not applicable to the verified magic",
      "headerFields": [
        {
          "name": "magic",
          "offset": "0x0",
          "width": 4,
          "type": "bytes",
          "meaning": "固定字节 45 45 58 00，即 ASCII EEX\\0"
        }
      ],
      "semantics": [
        "offset 0x00 的四字节魔数用于识别 EEX 文件"
      ],
      "sourceRefs": [
        "src.ccz.eex-reader"
      ]
    },
    {
      "id": "format.hexzmap.terrain-directory",
      "title": "Hexzmap 地形目录",
      "versions": [
        "6.5",
        "6.6"
      ],
      "status": "canonical",
      "evidence": "source-reviewed",
      "endianness": "big for directory fields",
      "header": {
        "directoryOffset": "0x110"
      },
      "directory": {
        "entrySize": 12
      },
      "entryFields": [
        {
          "name": "segment_length",
          "offset": "0x0",
          "width": 4,
          "type": "uint32be",
          "meaning": "存储段长度"
        },
        {
          "name": "decoded_length",
          "offset": "0x4",
          "width": 4,
          "type": "uint32be",
          "meaning": "解码长度/长度副本"
        },
        {
          "name": "file_offset",
          "offset": "0x8",
          "width": 4,
          "type": "uint32be",
          "meaning": "段起始文件偏移"
        }
      ],
      "payload": {
        "terrainDataOffsetWithinSegment": 2,
        "cellCountRule": "decoded_length - 2 >= map_cell_count",
        "directEditRule": "segment_length == decoded_length == map_cell_count + 2"
      },
      "sourceRefs": [
        "src.ccz.hexzmap-reader"
      ]
    },
    {
      "id": "format.item.split-data-star",
      "title": "6.5/6.6 分段物品表存储",
      "versions": [
        "6.5",
        "6.6"
      ],
      "status": "canonical",
      "evidence": "source-reviewed",
      "endianness": "little",
      "recordSize": 25,
      "segments": [
        {
          "file": "Data.e5",
          "offset": 33164,
          "count": 104
        },
        {
          "file": "Star.e5",
          "offset": 0,
          "count": 151
        }
      ],
      "semantics": [
        "合计 255 条，逻辑 ID 0..254；Data.e5 +33164 保存 0..103，Star.e5 +0 保存 104..254，均 25 字节。",
        "6.5 和 6.6 17 字节兼容 Variant 名称区 0x11 字节、图标为 +0x14；6.6 标准/旧山贼候选 Variant 名称区 0x0F 字节、图标为 +0x0F，+0x10/+0x14 是 Preserve 原始字节。各 Variant 的图标字段统一名为图标、类型 UInt8、字段策略 Editable。",
        "图标值 N 从 0 开始，对应 E5/Item.e5 的小图 #2N+1 与大图 #2N+2；不能将逻辑图标号、1 起始 E5 图号和版本内字节偏移混用。",
        "6.6 15 字节记录 +0x11/+0x12 的类型/特效动态语义与原始类别标记有关，必须使用目标 Codec，不能按字段名固定偏移迁移。"
      ],
      "sourceRefs": [
        "src.wrench.profile",
        "src.data-manager.profile65",
        "src.data-manager.profile66",
        "src.data-manager.codecs",
        "src.data-manager.studio-item-layout",
        "src.data-manager.studio-icon-mapping"
      ]
    }
  ]
